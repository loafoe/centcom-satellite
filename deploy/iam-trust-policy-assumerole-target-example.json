{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TrustCentcomSatelliteSourceRole",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::SOURCE_ACCOUNT_ID:role/SOURCE_IRSA_ROLE_NAME"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "sts:ExternalId": "OPTIONAL_EXTERNAL_ID_IF_USED"
        }
      }
    }
  ]
}
